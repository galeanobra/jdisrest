# Normalize line endings: text files are stored with LF in the repository and,
# because eol=lf takes precedence over core.autocrlf and core.eol, checked out
# with LF on every OS, Windows included. Only the scripts listed further down
# get CRLF.
* text=auto eol=lf

# Explicitly text with LF endings (safe for scripts that must run on Linux)
*.java  text eol=lf
*.xml   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.sh    text eol=lf

# Windows-native scripts keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets (add as needed)
*.jar   binary
*.png   binary
*.jpg   binary
*.gml   binary
