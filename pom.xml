<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>es.unex</groupId>
    <artifactId>jdisrest</artifactId>
    <version>1.3.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0 or later</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Jesús Galeano Brajones</name>
            <email>jgaleanobra@unex.es</email>
            <organization>GITACA – Universidad de Extremadura</organization>
            <organizationUrl>https://gitaca.unex.es/</organizationUrl>
        </developer>
        <developer>
            <name>Francisco Luna</name>
            <url>https://orcid.org/0000-0002-0455-7223</url>
            <organization>Universidad de Málaga</organization>
        </developer>
    </developers>

    <name>jdisrest</name>
    <description>
        Distributed REST-based master/worker framework for jMetal-encoded
        optimization problems. Provides an embedded Spring Boot master that
        exposes a task API consumed by remote workers; steady-state NSGA-II,
        MOEA/D, SMS-EMOA and PAES; a base class for generational masters;
        configuration files and a launcher for problems of every encoding;
        and a Java worker.
    </description>
    <url>https://github.com/galeanobra/jdisrest</url>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.0.4</spring-boot.version>
        <jmetal.version>7.1</jmetal.version>
    </properties>

    <build>
        <!-- Declaring resources replaces Maven's default, so src/main/resources is listed too. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The license travels inside the jar, as META-INF/LICENSE. -->
            <resource>
                <directory>${project.basedir}</directory>
                <includes>
                    <include>LICENSE</include>
                </includes>
                <targetPath>META-INF</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- JUnit 6 (managed by spring-boot-dependencies) needs Surefire 3.5.x. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
            </plugin>
            <!-- Integration tests (*IT, which Surefire leaves out) run in mvn verify. Each class
                 starts a real master, which registers itself in static singletons, so each gets a
                 JVM of its own; they run only when jdisrest.it is true, so an IDE that runs every
                 test in one JVM skips them. They run in target/it-workdir, so a file written to the
                 current directory stays out of the source tree. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.5</version>
                <configuration>
                    <forkCount>1</forkCount>
                    <reuseForks>false</reuseForks>
                    <workingDirectory>${project.build.directory}/it-workdir</workingDirectory>
                    <systemPropertyVariables>
                        <jdisrest.it>true</jdisrest.it>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring WebFlux (Netty, reactive) for the REST master endpoint. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Actuator: GET /actuator/health on the master's port, a liveness check for scripts. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Jackson 2 (com.fasterxml), used directly by AbstractMaster (.master-endpoint), the
             status.json writer, RestWorker and PythonProcessEvaluator. WebFlux serializes the REST
             payloads with Jackson 3 (tools.jackson), which it brings in itself; both read the
             com.fasterxml.jackson.annotation annotations of the DTOs. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- jMetal core + algorithm + parallel. -->
        <dependency>
            <groupId>org.uma.jmetal</groupId>
            <artifactId>jmetal-core</artifactId>
            <version>${jmetal.version}</version>
        </dependency>
        <dependency>
            <groupId>org.uma.jmetal</groupId>
            <artifactId>jmetal-algorithm</artifactId>
            <version>${jmetal.version}</version>
        </dependency>
        <dependency>
            <groupId>org.uma.jmetal</groupId>
            <artifactId>jmetal-parallel</artifactId>
            <version>${jmetal.version}</version>
        </dependency>

        <!-- Unit and integration tests (version managed by spring-boot-dependencies). -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
